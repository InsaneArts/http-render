// Cloudflare Workers deploy for the website: `pnpm build && npx wrangler deploy`.
// The built site is served as static assets; /api/send runs the relay in apps/web/worker.ts.
{
  "name": "http-render",
  "main": "apps/web/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
