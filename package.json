{
  "name": "http-render-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './apps/*' build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx apps/cli/src/cli.ts",
    "web": "pnpm --filter @http-render/web dev",
    "gen": "node packages/renderer/scripts/gen-templates.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.9.0"
}
